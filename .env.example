# =====================================================
# Financial RAG — Environment Variables Template
# Copy this file to .env and fill in your values
# =====================================================

# ----- Database -----
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./financial_dms.db

# PostgreSQL (uncomment and edit to use)
# DATABASE_URL=postgresql://user:password@localhost/finrag

# ----- JWT Authentication -----
SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Qdrant Vector Database -----
# Leave QDRANT_HOST empty to use local folder storage (default)
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_storage

# ----- Embedding & Reranking Models -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----- LLM Provider -----
# Options: ollama | openai | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Ollama (local, free) — make sure Ollama is running: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (uncomment if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Google Gemini (uncomment if LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=AIza...
